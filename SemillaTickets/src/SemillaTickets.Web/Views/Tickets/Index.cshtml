@using SemillaTickets.Web.Helpers
@model TicketsIndexViewModel
@{
    ViewData["Title"] = "Tickets";
}

<h1 class="h4 mb-3">Tickets de incidencias</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input asp-for="Buscar" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-md-3">
        <select asp-for="Estado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in Estados.Todos)
            {
                <option value="@e" selected="@(e == Model.Estado)">@e</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select asp-for="Prioridad" class="form-select">
            <option value="">Todas las prioridades</option>
            @foreach (var p in Prioridades.Todas)
            {
                <option value="@p" selected="@(p == Model.Prioridad)">@p</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpiar</a>
    </div>
</form>

@* Token antifalsificación que site.js envía en la cabecera de la petición Ajax. *@
@Html.AntiForgeryToken()

<div id="mensaje-estado" class="alert d-none" role="alert"></div>

<table class="table table-sm table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Título</th>
            <th>Prioridad</th>
            <th>Estado</th>
            <th>Responsable</th>
            <th>Creado</th>
            <th>Cierre</th>
            <th>SLA vencido</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="tabla-tickets" data-url-cambiar-estado="@Url.Action("CambiarEstado")">
        @if (Model.Tickets.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No hay tickets que coincidan con los filtros.</td>
            </tr>
        }
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.Titulo</td>
                <td>@t.Prioridad</td>
                <td>
                    <select class="form-select form-select-sm cambiar-estado"
                            data-id="@t.Id"
                            data-estado-actual="@t.Estado"
                            aria-label="Cambiar estado del ticket @t.Id"
                            disabled="@(t.Estado == Estados.Cerrado)">
                        @foreach (var e in Estados.Todos)
                        {
                            <option value="@e" selected="@(e == t.Estado)">@e</option>
                        }
                    </select>
                </td>
                <td>@(t.Responsable ?? "—")</td>
                <td>@t.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="fecha-cierre">@(t.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                <td class="sla-vencido">@(SlaHelper.VenceSla(t, Model.Ahora) ? "Sí" : "No")</td>
                <td><a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Editar</a></td>
            </tr>
        }
    </tbody>
</table>
